    {
      "name": "05 — Outbox operations",
      "description": "Administrator-only, deterministic operational checks. The collection does not manufacture a dead letter.",
      "item": [
        {
          "name": "Read outbox status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/operations/outbox",
            "description": "Reads backlog and dead-letter metadata without returning domain-event payloads."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Outbox status returns 200', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "pm.test('Operational counters and dead-letter metadata are present', () => {",
                  "  pm.expect(payload.pendingCount).to.be.a('number');",
                  "  pm.expect(payload.deadLetterCount).to.be.a('number');",
                  "  pm.expect(payload.deadLetters).to.be.an('array');",
                  "});",
                  "pm.test('Operational response does not expose event payloads', () => pm.expect(JSON.stringify(payload).toLowerCase()).not.to.include('payload'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Replay unknown event — 404",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/operations/outbox/00000000-0000-0000-0000-000000000001/replay",
            "description": "Replay is exercised safely with an event ID that does not exist."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unknown outbox event returns 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
