{
  "info": {
    "_postman_id": "8f02493d-73ca-4f85-b986-b5333d7eb87a",
    "name": "DeveloperStore Sales API — Reviewer Collection",
    "description": "A deterministic reviewer collection for the delivered DeveloperStore sales workflow. Run folders in order. It covers health, rotating cookie-backed sessions, sale rules, strong ETag concurrency, validation/security failures, administrator outbox operations, logout, and post-logout rejection. No credential or token is stored in the export.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
