    {
      "name": "06 — Session termination",
      "description": "End the reviewer flow by revoking the refresh family, clearing the cookie, and proving anonymous requests remain rejected.",
      "item": [
        {
          "name": "Logout — revoke family and clear cookie",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Uses the current refresh cookie. Logout remains available even when an access token has expired.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout returns 204', () => pm.response.to.have.status(204));",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "pm.test('Refresh cookie is cleared', () => {",
                  "  pm.expect(setCookie).to.match(/(?:__Host-)?developerstore-refresh=/);",
                  "  const normalizedCookie = setCookie.toLowerCase();",
                  "  pm.expect(normalizedCookie.includes('expires=') || normalizedCookie.includes('max-age=0')).to.eql(true);",
                  "});",
                  "pm.collectionVariables.unset('accessToken');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh after logout — 401",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "The previous refresh family was revoked and its browser cookie was cleared.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Revoked or cleared session cannot refresh', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
