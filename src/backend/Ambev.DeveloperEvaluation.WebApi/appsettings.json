{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Ambev.DeveloperEvaluation",
    "Audience": "Ambev.DeveloperEvaluation.Client",
    "ExpirationMinutes": 15
  },
  "RefreshSession": {
    "IdleExpirationDays": 7,
    "AbsoluteExpirationDays": 30,
    "TokenSizeBytes": 64,
    "ReuseGraceSeconds": 10,
    "CleanupRetentionDays": 7,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 1000,
    "CleanupMaxBatchesPerCycle": 10,
    "CookieName": "__Host-developerstore-refresh",
    "SecureCookie": true
  },
  "Telemetry": {
    "Enabled": false,
    "ServiceName": "ambev-sales-api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "LoginRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "MongoAudit": {
    "Enabled": false,
    "ConnectionString": "",
    "DatabaseName": "developer_evaluation_audit",
    "CollectionName": "sale_events"
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 30,
    "MaxAttempts": 10,
    "BaseRetrySeconds": 2,
    "MaxRetrySeconds": 300,
    "DegradedBacklogAgeSeconds": 60,
    "ProcessedRetentionDays": 7,
    "CleanupIntervalMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
